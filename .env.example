# Variables de entorno — sección 5.3 de la especificación.
# Copia este archivo a .env.local y rellena los valores. NO comitear .env.local.

# --- Base de datos (Neon) ---
# Conexión pooled a Neon (la genera `neon deploy`).
DATABASE_URL=
# Conexión directa para migraciones (si Neon la genera).
DATABASE_URL_UNPOOLED=

# --- Autenticación (Better Auth) ---
# Secreto para firmar sesiones. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL base de la app (p. ej. http://localhost:3000 en local).
BETTER_AUTH_URL=http://localhost:3000
# Único email autorizado a registrarse/iniciar sesión (AU-001/AU-003).
OWNER_EMAIL=

# --- Object storage (imágenes, PDFs, adjuntos, covers) ---
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# --- IA ---
# Funciones de IA (Claude).
ANTHROPIC_API_KEY=
# Embeddings para búsqueda semántica.
VOYAGE_API_KEY=

# --- Web Push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Email de recordatorio (opcional) ---
RESEND_API_KEY=

# --- Cron ---
# Protege los endpoints /api/cron/*.
CRON_SECRET=

# --- Galería de portadas (opcional) ---
UNSPLASH_ACCESS_KEY=
